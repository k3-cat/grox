{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "grox",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-20",
	"compatibility_flags": ["nodejs_compat"],

	"workers_dev": false,

	"minify": true,

	"placement": { "mode": "smart" },

	"vars": {
		"CIP_REPO": "k3-cat/cip",
	},

	"assets": {
		"directory": "./static",
		"binding": "STATIC",
		"run_worker_first": false,
	},

	"kv_namespaces": [
		{ "binding": "KV_AUTH", "id": "27f5d7a1e3974828826ec85a1e74ed72" },
		{ "binding": "KV_GROX", "id": "bfe0c5c769bd46b39fc2316d3670fb19" },
	],

	"r2_buckets": [
		{ "binding": "R2_CUBE", "bucket_name": "cube" },
		{ "binding": "R2_BACKUP", "bucket_name": "backup" },
	],
}
